# Optional future values if you connect this to Magento API.
MAGENTO_BASE_URL=https://your-magento-store.example.com
MAGENTO_ACCESS_TOKEN=replace_me

# Optional Google Sheets input connector.
CATALOG_INPUT_SOURCE=google-sheet
GOOGLE_SHEET_ID=replace_with_spreadsheet_id
GOOGLE_SHEET_RANGE='01_Input_Raw_Products'!A:ZZ
GOOGLE_SHEETS_AUTH_MODE=auto
GOOGLE_SERVICE_ACCOUNT_FILE=C:\secure\catalog-sheets-reader.json
GOOGLE_SHEETS_TIMEOUT_SECONDS=15
GOOGLE_SHEETS_MAX_RETRIES=2
